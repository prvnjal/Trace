# --- Postgres ---
POSTGRES_DB=thermal_intel
POSTGRES_USER=thermal
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://thermal:change_me_in_env@localhost:5432/thermal_intel

# --- NASA FIRMS (get a free key at https://firms.modaps.eosdis.nasa.gov/api/) ---
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BBOX=68,6,97,37
NASA_FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,MODIS_NRT
NASA_FIRMS_DAY_RANGE=2

# --- Automatic refresh schedule ---
# Hours between automatic FIRMS refreshes while the API container is running.
# 0 disables the scheduler (manual POST /admin/refresh still works).
FIRMS_REFRESH_HOURS=6
